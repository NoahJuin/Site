# Copiez ce fichier en .env (ou saisissez ces variables chez votre hébergeur).

# --- Boutique ---
NODE_ENV=production
PORT=3000
BASE_URL=https://www.votre-domaine.fr
SHOP_NAME=Dormea
SUPPORT_EMAIL=contact@votre-domaine.fr
ADMIN_EMAIL=vous@votre-domaine.fr
DATABASE_PATH=data/shop.db

# --- Admin (/admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=changez-moi-avec-un-mot-de-passe-long

# --- Stripe (dashboard.stripe.com → Développeurs) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
CHECKOUT_SESSION_MINUTES=60

# --- E-mails (Brevo, Resend, Postmark, Gmail… tout SMTP) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dormea <contact@votre-domaine.fr>"

# --- Fournisseur : mock (test) | email (transfert auto à votre agent) | cj (API CJdropshipping) ---
SUPPLIER_PROVIDER=email
SUPPLIER_EMAIL=agent@fournisseur.com
CJ_API_KEY=
CJ_LOGISTIC_NAME=CJPacket Ordinary
CJ_FROM_COUNTRY=CN
# Identifiants de variantes chez le fournisseur (CJ « vid » ou SKU de votre agent)
SUPPLIER_VID_NOIR=
SUPPLIER_VID_GRIS=
SUPPLIER_VID_BLEU=
# Coût d'achat unitaire livré, en centimes (pour le calcul de marge)
UNIT_COST_CENTS=950

# --- Livraison ---
SHIPPING_COUNTRIES=FR,BE,LU,MC
SHIPPING_DAYS_MIN=6
SHIPPING_DAYS_MAX=10

# --- Automatisations ---
ENABLE_SCHEDULER=true
JOBS_INTERVAL_MINUTES=30
MAX_FULFILLMENT_ATTEMPTS=5
REVIEW_REQUEST_DAYS=14
# Heure UTC d'envoi du rapport quotidien
DAILY_REPORT_HOUR=7
AUTO_APPROVE_REVIEWS=true

# --- Assistant service client IA (optionnel) — console.anthropic.com ---
ANTHROPIC_API_KEY=
SUPPORT_MODEL=claude-opus-5-5

# --- Code de bienvenue (pop-up e-mail). Créez d'abord le code promo dans Stripe. ---
WELCOME_CODE=BIENVENUE10
WELCOME_TEXT=-10 % sur votre première commande

# --- Pixels publicitaires (chargés seulement après consentement cookies) ---
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
GA4_ID=

# --- Mentions légales (obligatoires) ---
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_SIRET=
COMPANY_VAT=
PUBLISHER_NAME=
HOST_NAME=
MEDIATOR=
